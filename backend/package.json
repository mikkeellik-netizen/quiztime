    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/websockets": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@prisma/client": "^5.9.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "ioredis": "^5.3.2",
    "socket.io": "^4.7.4",
    "zod": "^3.22.4",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
