# ╔══════════════════════════════════════════╗
# ║  QuizTime — Переменные окружения         ║
# ║  Скопируй этот файл в .env               ║
# ║  и заполни свои значения                 ║
# ╚══════════════════════════════════════════╝

# ── База данных ────────────────────────────
# Не меняй, если используешь docker-compose.dev.yml
DATABASE_URL="postgresql://quizuser:quizpass123@localhost:5432/quiztime"

# ── Redis ──────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Сервер ─────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT (придумай любую длинную строку) ────
# Пример: mysupersecretkey2024quiztime_abc123
JWT_SECRET=ЗАМЕНИ_НА_ЛЮБОЙ_ДЛИННЫЙ_ТЕКСТ_БЕЗ_ПРОБЕЛОВ
JWT_EXPIRES_IN=7d

# ── Telegram Bot ───────────────────────────
# Получи у @BotFather командой /newbot
# Выглядит так: 1234567890:AABBccDDeeFFggHHiiJJkkLLmmNNoo
BOT_TOKEN=ВСТАВЬ_СЮДА_ТОКЕН_ОТ_BOTFATHER

# ── Публичный URL (ngrok) ──────────────────
# После запуска ngrok скопируй URL сюда
# Пример: https://abc123.ngrok-free.app
PUBLIC_URL=ВСТАВЬ_СЮДА_URL_ОТ_NGROK

# ── CORS (фронтенд) ────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Лимиты ────────────────────────────────
MAX_PARTICIPANTS=1000
